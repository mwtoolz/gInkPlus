<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<Platforms>x86</Platforms>
		<PlatformTarget>x86</PlatformTarget>

		<OutputPath>bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		
		<AssemblyName>gInkPlus</AssemblyName>
		<ApplicationIcon>src\icon_red.ico</ApplicationIcon>
		
		<Version>1.4.0</Version>
		<AssemblyVersion>1.4.0.0</AssemblyVersion>
		<AssemblyInformationalVersion>1.4.0</AssemblyInformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<FileVersion>1.4.0.0</FileVersion>
		
		<Product>gInkPlus</Product>
		<Company>mwtoolz</Company>
		<Copyright>Copyright © 2016-2020 Weizhi Nai (gInk); Copyright © 2026 mwtoolz (gInkPlus)</Copyright>

	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Microsoft.Ink">
			<HintPath>Microsoft.Ink.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="src\Properties\Resources.resx">
			<LogicalName>gInkPlus.Properties.Resources.resources</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Content Include="src\icon_*.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="lang\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="config\*.ini">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="..\README.md">
			<Link>README.md</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\LICENSE">
			<Link>LICENSE</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\CHANGELOG.md">
			<Link>CHANGELOG.md</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\THIRD-PARTY-NOTICES.txt">
			<Link>THIRD-PARTY-NOTICES.txt</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


</Project>